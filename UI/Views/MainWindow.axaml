<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://microsoft.com"
        x:Class="UI.Views.MainWindow"
        Title="Лабораторная работа №1 — Симуляция луча"
        Width="700" Height="450"
        Background="#1e1e1e">

    
    <Grid ColumnDefinitions="280, *">
        <!-- Левая панель управления -->
        <StackPanel Grid.Column="0" Margin="15" Spacing="12">
            <TextBlock Text="Параметры среды" FontSize="16" FontWeight="Bold" Foreground="White"/>
            
            <TextBlock Text="Формула функции n(y):" Foreground="LightGray"/>
            <TextBox Name="FormulaInput" Text="1.0 + 0.05*y" PlaceholderText="Введите формулу"/>
            
            <!-- Кнопка проверки формулы (работает с check.json) -->
            <Button Name="CheckButton" Content="Проверить формулу" 
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Background="#2d2d2d" Foreground="White" Click="OnCheckButtonClick"/>
            
            <TextBlock Text="Начальный угол (град):" Foreground="LightGray" Margin="0,10,0,0"/>
            <TextBox Name="AngleInput" Text="45"/>
            
            <!-- Кнопка запуска симуляции (работает с run.json) -->
            <Button Name="RunButton" Content="Запустить расчет" 
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Background="#007acc" Foreground="White" FontWeight="Bold" 
                    Click="OnRunButtonClick" Margin="0,15,0,0"/>
        </StackPanel>
        
        <!-- Правая панель: Вывод логов и графики -->
        <Grid Grid.Column="1" RowDefinitions="*, 120" Margin="10">
            <!-- Место под будущий график луча -->
            <Border Grid.Row="0" Background="#121212" CornerRadius="5">
                <Canvas Name="RayCanvas"/>
            </Border>
            
            <!-- Поле вывода статуса/ошибок -->
            <Border Grid.Row="1" Background="#1a1a1a" Margin="0,10,0,0" CornerRadius="5" Padding="10">
                <ScrollViewer>
                    <TextBlock Name="StatusLog" Text="Программа готова к работе..." 
                               Foreground="#00ff00" TextWrapping="Wrap" FontFamily="Consolas"/>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
